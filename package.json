{
  "name": "paopao-guoxue",
  "version": "1.0.0",
  "private": true,
  "description": "泡泡国学堂 — a single-file Chinese literacy game for young children",
  "scripts": {
    "build": "node game/build.mjs",
    "check:build": "node game/build.mjs --check",
    "test": "node --test game/tests/ printer/tests/",
    "test:game": "node --test game/tests/",
    "test:printer": "node --test printer/tests/",
    "print:assets": "node printer/scripts/print-assets.mjs",
    "print:dev": "node printer/scripts/serve.mjs",
    "print": "node printer/scripts/print-pdf.mjs",
    "print:pdf": "node printer/scripts/print-pdf.mjs",
    "print:layout-1": "node printer/scripts/print-pdf.mjs layout 1",
    "print:layout-2": "node printer/scripts/print-pdf.mjs layout 2",
    "print:layout-3": "node printer/scripts/print-pdf.mjs layout 3",
    "print:layout-4": "node printer/scripts/print-pdf.mjs layout 4",
    "test:e2e": "node printer/scripts/print-pdf.mjs --e2e",
    "test:e2e:cli": "node --test printer/e2e/cli-print.spec.mjs"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.13",
    "emojibase-data": "^18.0.0",
    "pdfjs-dist": "^6.4.299",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0"
  }
}
