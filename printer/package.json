{
  "name": "hanzi-printer",
  "version": "1.0.0",
  "description": "Offline-ready Chinese character (Hanzi) worksheet & Tianzige practice sheet printer",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node scripts/serve.mjs",
    "print": "node scripts/print-pdf.mjs",
    "print:layout-1": "node scripts/print-pdf.mjs layout 1",
    "print:layout-2": "node scripts/print-pdf.mjs layout 2",
    "print:layout-3": "node scripts/print-pdf.mjs layout 3",
    "print:layout-4": "node scripts/print-pdf.mjs layout 4",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node scripts/print-pdf.mjs --e2e",
    "test:e2e:cli": "node --test e2e/cli-print.spec.mjs",
    "test:e2e:r150l3": "node --test e2e/r150l3.spec.mjs",
    "build:assets": "node scripts/print-assets.mjs",
    "build:strokes": "node scripts/print-assets.mjs strokes",
    "build:strokes:pretty": "node scripts/print-assets.mjs strokes --pretty"
  }
}
